# تسميع fixtures: regenerate with `node scripts/tasmee/build-fixtures.mjs`.
# The audio is 66MB of someone else's recitation and rebuilds in a minute;
# the manifest that labels it is committed, so the set is reproducible.
scripts/tasmee/fixtures/clips/
scripts/tasmee/fixtures/.work/
scripts/tasmee/fixtures/recorded/
scripts/tasmee/fixtures/.scores.json
scripts/tasmee/fixtures/.emissions.json
# The large set is 546MB of generated audio; rebuild with
# `node scripts/tasmee/build-word-fixtures.mjs`.
scripts/tasmee/fixtures-large/clips/
scripts/tasmee/fixtures-large/.work/
scripts/tasmee/fixtures-large/.scores.json
scripts/tasmee/fixtures-large/.emissions.json

# Page-length passages: `node scripts/tasmee/build-page-fixtures.mjs`.
scripts/tasmee/fixtures-page/clips/
scripts/tasmee/fixtures-page/.work/
scripts/tasmee/fixtures-page/.scores.json
scripts/tasmee/fixtures-page/.emissions.json

# Ordinary people reciting, from the CC0 Tarteel.io half of
# ashraf-ali/quran-data on Hugging Face: 18,415 clips, 47.4 hours, 5.5GB.
# Everything here is derived, so none of it is committed - the manifest is
# rebuilt from the dataset's own index by
# `node scripts/tasmee/build-learner-fixtures.mjs`, which is.
scripts/tasmee/fixtures-learner/manifest.json
scripts/tasmee/fixtures-learner/clips
scripts/tasmee/fixtures-learner/.work/
scripts/tasmee/fixtures-learner/.scores.json
scripts/tasmee/fixtures-learner/.emissions.json

# Word-level mistakes cut from those same clips, all derived:
# `node scripts/tasmee/build-learner-mistakes.mjs`.
scripts/tasmee/fixtures-learner-mistakes/

# Slips into a twin ayah, cut from Quran.com's audio, all derived:
# `node scripts/tasmee/build-twin-slips.mjs`.
scripts/tasmee/fixtures-twins/

# A systematic sample of the above for `evaluate.mjs`, which is serial:
# `node scripts/tasmee/sample-fixtures.mjs --count 1000`. It references the
# full set's audio rather than copying it.
scripts/tasmee/fixtures-learner-sample/

# Labelled learner recitation from RetaSy/quranic_audio_dataset (CC BY 4.0).
# The audio is not ours to redistribute, so none of it is committed; rebuild
# with `node scripts/tasmee/build-retasy-fixtures.mjs`.
scripts/tasmee/fixtures-retasy/

# Al-Ikhlas by 384 ordinary people, checked by Qur'an experts (CC BY 4.0,
# Mendeley Data 10.17632/sxtmmr6mvk.1). People's voices and 1GB, so none of
# it is committed: `node scripts/tasmee/build-ikhlas-fixtures.mjs`.
scripts/tasmee/fixtures-ikhlas/

# Short surahs with the wrong word named by a reviewer, from
# sobolev210/quran-recitation-errors (MIT): `build-sobolev-fixtures.mjs`.
scripts/tasmee/fixtures-sobolev/

# Runs exported from the app with the reciter's own answers - given
# privately, never committed: `build-feedback-fixtures.mjs`.
scripts/tasmee/fixtures-feedback/

# Whole recitations with reviewed word timings, from the Quran Recitation
# Alignment Benchmark (CC BY 4.0): `build-qud-fixtures.mjs`.
scripts/tasmee/fixtures-qud/

# Gated model weights, fetched locally and never committed
.models/

# Progress log from `node scripts/tasmee/measure.mjs`.
scripts/tasmee/.measure.log

# Local knowledge graph from graphify; rebuild with `/graphify .`.
graphify-out/
